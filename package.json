{
  "name": "@buddhaflow/n8n-nodes-musicgpt",
  "version": "1.0.0",
  "description": "n8n node for MusicGPT API to create AI-generated music",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://github.com/drsounds/musicgpt-n8n-node",
  "author": {
    "name": "Alexander Forselius",
    "email": "drsounds@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drsounds/musicgpt-n8n-node"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && npm run copy",
    "copy": "copyfiles -u 1 'dist/**/*' .",
    "dev": "tsc --watch",
    "format": "prettier --write \"{nodes,credentials}/**/*.{ts,js,json}\"",
    "lint": "eslint nodes credentials --ext .ts,.js",
    "lint:fix": "eslint nodes credentials --ext .ts,.js --fix",
    "prepublishOnly": "npm run build && npm run lint && npm run format",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesFolder": "dist",
    "nodes": [
      "dist/nodes/MyApp.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/request": "^2.48.13",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "copyfiles": "^2.4.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "n8n-core": "*",
    "n8n-workflow": "*",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.2.0"
  },
  "dependencies": {
    "@n8n/node-cli": "^0.15.0",
    "n8n-workflow": "*",
    "request": "^2.88.2"
  }
}
